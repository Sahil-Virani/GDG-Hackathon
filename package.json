{
  "name": "outfit-rating-battle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch server/src/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "setup:assets": "node scripts/setup-assets.mjs",
    "postinstall": "npm run setup:assets",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@opentok/client": "2.35.2",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@vonage/server-sdk": "3.30.1",
    "@vonage/video": "1.31.1",
    "canvas-confetti": "1.9.4",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "framer-motion": "13.2.0",
    "lucide-react": "1.45.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "tailwindcss": "4.3.3",
    "three": "0.186.0",
    "zod": "4.6.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
