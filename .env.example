# Demo runs without credentials. Set false to enable real Gemini judging.
DEMO_MODE=true
# Vonage video is enabled whenever both credentials are supplied, even in demo mode.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=
GEMINI_API_KEY=
GEMINI_SCORING_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
PORT=3002
# Each capture round has a deadline so inactive players cannot stall the game.
ROUND_TIMEOUT_SECONDS=180
