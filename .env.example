# Demo runs without credentials. Set false to enable real Gemini judging.
DEMO_MODE=true
# Vonage video is enabled whenever both credentials are supplied, even in demo mode.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=
GEMINI_API_KEY=
GEMINI_SCORING_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Alternative to GEMINI_API_KEY: authenticate via a GCP service account through Vertex AI.
# When true, GOOGLE_CLOUD_PROJECT/LOCATION/APPLICATION_CREDENTIALS are required and
# GEMINI_API_KEY is ignored. Requires the Vertex AI API enabled on that GCP project,
# and GEMINI_SCORING_MODEL/GEMINI_IMAGE_MODEL set to models published on Vertex AI
# (not every Gemini API model is available there under the same name).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
PORT=3002
# Each capture round has a deadline so inactive players cannot stall the game.
ROUND_TIMEOUT_SECONDS=180
